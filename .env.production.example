# Environment variables for production deployment on Hostinger
# Copy these settings to your Hostinger control panel environment variables

# Application Environment
NODE_ENV=production

# Database Configuration
# Replace with your actual Hostinger database credentials
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_database_name

# Email Configuration (Gmail SMTP)
GMAIL_USER=rootscrown.rwanda@gmail.com
GMAIL_APP_PASSWORD=ljvr hfgh xbrs xtms

# Application URL (replace with your actual domain)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Optional: Port (Hostinger usually handles this automatically)
PORT=3000

# Optional: Hostname
HOSTNAME=0.0.0.0
